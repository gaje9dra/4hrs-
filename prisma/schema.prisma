model Case {
  id                 String            @id @default(uuid()) @db.Uuid
  caseReference      String            @unique @db.VarChar(64)
  customerId         String?           @db.Uuid
  orderId            String?           @db.Uuid
  orderItemId        String?           @db.Uuid
  shipmentId         String?           @db.Uuid
  fulfillmentId      String?           @db.Uuid
  returnRequestId    String?           @db.Uuid
  cancellationRequestId String?        @db.Uuid
  paymentId          String?           @db.Uuid
  category           CaseCategory
  status             CaseStatus        @default(OPEN)
  priority           CasePriority      @default(NORMAL)
  source             CaseSource
  sourceReference    String?           @db.VarChar(255)
  deduplicationKey   String?           @unique @db.VarChar(255)
  title              String            @db.VarChar(200)
  customerDescription String?          @db.VarChar(4000)
  resolutionType     CaseResolutionType?
  resolutionSummary  String?           @db.VarChar(1000)
  assignedOperatorId String?           @db.Uuid
  correlationId      String?           @db.VarChar(128)
  version            Int               @default(1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  resolvedAt         DateTime?
  closedAt           DateTime?
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order              Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem          OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  shipment           Shipment?         @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  fulfillment        Fulfillment?      @relation(fields: [fulfillmentId], references: [id], onDelete: Restrict)
  returnRequest      ReturnRequest?    @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  cancellationRequest CancellationRequest? @relation(fields: [cancellationRequestId], references: [id], onDelete: Restrict)
  payment            Payment?          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  assignedOperator   Customer?         @relation("CaseAssignee", fields: [assignedOperatorId], references: [id], onDelete: Restrict)
  notes              CaseNote[]
  audits             CaseAuditEvent[]
  assignments        CaseAssignment[]
  @@index([customerId, createdAt])
  @@index([orderId, createdAt])
  @@index([status, priority, updatedAt])
  @@index([assignedOperatorId, status, updatedAt])
  @@index([category, createdAt])
  @@index([source, sourceReference])
}

model CaseNote {
  id        String   @id @default(uuid()) @db.Uuid
  caseId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String   @db.VarChar(4000)
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Restrict)
  author    Customer @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([caseId, createdAt])
}

model CaseAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  caseId     String   @db.Uuid
  operatorId String   @db.Uuid
  assignedAt DateTime @default(now())
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Restrict)
  operator   Customer @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  @@index([caseId, assignedAt])
  @@index([operatorId, assignedAt])
}

model CaseAuditEvent {
  id          String          @id @default(uuid()) @db.Uuid
  caseId      String          @db.Uuid
  actorId     String?         @db.Uuid
  action      CaseAuditAction
  previousState String?
  newState   String?
  reason      String?         @db.VarChar(1000)
  correlationId String?       @db.VarChar(128)
  createdAt   DateTime        @default(now())
  case        Case             @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor       Customer?        @relation("CaseAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
}

enum AdminAccountStatus {
  ACTIVE
  DISABLED
}

model AdminUser {
  id           String            @id @default(uuid()) @db.Uuid
  customerId   String            @unique @db.Uuid
  status       AdminAccountStatus @default(ACTIVE)
  version      Int               @default(1)
  lastLoginAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  roles        AdminUserRole[]
  auditLogs    AdminAuditLog[]   @relation("AdminAuditActor")
  createdContent ContentItem[] @relation("ContentCreatedBy")
  updatedContent ContentItem[] @relation("ContentUpdatedBy")
  publishedContent ContentItem[] @relation("ContentPublishedBy")
  contentRevisions ContentRevision[] @relation("ContentRevisionAuthor")
  @@index([status])
  @@index([updatedAt])
}

model AdminRole {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique @db.VarChar(64)
  description String?            @db.VarChar(255)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  admins      AdminUserRole[]
  permissions AdminRolePermission[]
}

model AdminPermission {
  id          String               @id @default(uuid()) @db.Uuid
  key         String               @unique @db.VarChar(120)
  description String?              @db.VarChar(255)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  roles       AdminRolePermission[]
  @@index([key])
}

model AdminUserRole {
  adminUserId String    @db.Uuid
  roleId      String    @db.Uuid
  assignedAt  DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        AdminRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@id([adminUserId, roleId])
  @@index([roleId])
}

model AdminRolePermission {
  roleId       String          @db.Uuid
  permissionId String          @db.Uuid
  assignedAt   DateTime        @default(now())
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AdminAuditLog {
  id              String    @id @default(uuid()) @db.Uuid
  actorAdminId    String?   @db.Uuid
  action          String    @db.VarChar(120)
  resourceType    String?   @db.VarChar(120)
  resourceId      String?   @db.VarChar(255)
  success         Boolean
  reason          String?   @db.VarChar(1000)
  correlationId   String?   @db.VarChar(128)
