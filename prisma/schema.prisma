model CancellationRequest {
  id             String           @id @default(uuid()) @db.Uuid
  cancellationReference String    @unique @db.VarChar(64)
  customerId     String           @db.Uuid
  orderId        String           @db.Uuid
  status         CancellationStatus @default(REQUESTED)
  reason         String           @db.VarChar(120)
  customerDescription String?     @db.VarChar(2000)
  operationalReason String?       @db.VarChar(500)
  requestedAt    DateTime         @default(now())
  reviewedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  cases          Case[]
  @@unique([orderId])
  @@index([customerId, createdAt])
  @@index([status, updatedAt])
}

model ReturnRequest {
  id             String             @id @default(uuid()) @db.Uuid
  returnReference String            @unique @db.VarChar(64)
  customerId     String             @db.Uuid
  orderId        String             @db.Uuid
  status         ReturnRequestStatus @default(REQUESTED)
  reasonCode     ReturnReasonCode
  customerDescription String?       @db.VarChar(2000)
  operationalReason String?         @db.VarChar(500)
  requestedAt    DateTime           @default(now())
  reviewedAt     DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items          ReturnItem[]
  shipment       ReturnShipment?
  inspection     ReturnInspection?
  resolution     ReturnResolution?
  cases          Case[]
  @@index([customerId, createdAt])
  @@index([orderId, createdAt])
  @@index([status, updatedAt])
}

model ReturnItem {
  id             String       @id @default(uuid()) @db.Uuid
  returnRequestId String      @db.Uuid
  orderItemId    String       @db.Uuid
  quantity       Int
  createdAt      DateTime     @default(now())
  returnRequest  ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId, createdAt])
}

model ReturnShipment {
  id                String              @id @default(uuid()) @db.Uuid
  returnRequestId   String              @unique @db.Uuid
  sourceShipmentId  String?             @db.Uuid
  reference         String              @unique @db.VarChar(64)
  status            ReturnShipmentStatus @default(RETURN_AUTHORIZED)
  carrier           String?             @db.VarChar(120)
  trackingNumber    String?             @db.VarChar(160)
  trackingUrl       String?             @db.VarChar(1000)
  externallySupplied Boolean            @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  returnRequest     ReturnRequest       @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  sourceShipment    Shipment?           @relation(fields: [sourceShipmentId], references: [id], onDelete: Restrict)
  @@index([sourceShipmentId])
  @@index([status, updatedAt])
}

model ReturnInspection {
  id                String                 @id @default(uuid()) @db.Uuid
  returnRequestId   String                 @unique @db.Uuid
  receivedQuantity  Int
  acceptedQuantity  Int
  rejectedQuantity  Int
  outcome            ReturnInspectionOutcome
  internalReason    String?                @db.VarChar(500)
  operatorId        String                 @db.VarChar(128)
  inspectedAt       DateTime               @default(now())
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  returnRequest     ReturnRequest          @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  @@index([operatorId, inspectedAt])
}

model ReturnResolution {
  id                String              @id @default(uuid()) @db.Uuid
  returnRequestId   String              @unique @db.Uuid
  type              ReturnResolutionType
  refundAmount      Decimal?            @db.Decimal(12, 2)
  currency          String?             @db.VarChar(3)
  paymentRefundIntentReference String?  @unique @db.VarChar(64)
  note              String?             @db.VarChar(500)
  resolvedBy        String              @db.VarChar(128)
  resolvedAt        DateTime            @default(now())
  createdAt         DateTime            @default(now())
  returnRequest     ReturnRequest       @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  @@index([type, resolvedAt])
}

model CommerceExceptionAuditEvent {
  id                String                    @id @default(uuid()) @db.Uuid
  actorType         CommerceExceptionActorType
  actorId           String?
  action            CommerceExceptionAction
  previousState     String?
  newState          String?
  reason            String?
  orderId           String                 @db.Uuid
  returnRequestId   String?                @db.Uuid
  cancellationRequestId String?            @db.Uuid
  orderItemId       String?                @db.Uuid
  correlationId     String?
  createdAt         DateTime               @default(now())
  @@index([orderId, createdAt])
  @@index([returnRequestId, createdAt])
  @@index([cancellationRequestId, createdAt])
  @@index([correlationId, createdAt])
}

model CustomerCommunicationPreference {
  id          String                        @id @default(uuid()) @db.Uuid
  customerId  String                        @db.Uuid
  category    CommunicationCategory
  channel     CommunicationChannel
  state       CommunicationPreferenceState
  source      CommunicationPreferenceSource
  version     Int                           @default(1)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  customer    Customer                      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, category, channel])
  @@index([customerId, updatedAt])
  @@index([category, channel, state])
}

model CustomerCommunicationPreferenceAudit {
  id             String                           @id @default(uuid()) @db.Uuid
  customerId     String                           @db.Uuid
  category       CommunicationCategory
  channel        CommunicationChannel
  previousState  CommunicationPreferenceState?
  newState       CommunicationPreferenceState
  source         CommunicationPreferenceSource
  actorType      CommunicationPreferenceActorType
  correlationId  String?                          @db.VarChar(128)
  idempotencyKey  String?                          @unique @db.VarChar(255)
  reason          String?                          @db.VarChar(1000)
  createdAt      DateTime                         @default(now())
  customer       Customer                         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([category, channel, createdAt])
  @@index([correlationId, createdAt])
}

model CommunicationUnsubscribeToken {
  id          String                @id @default(uuid()) @db.Uuid
  customerId  String                @db.Uuid
  tokenHash   String                @unique @db.VarChar(128)
  category    CommunicationCategory
  channel     CommunicationChannel
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime              @default(now())
  customer    Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
  @@index([expiresAt, usedAt])
}

model NotificationEvent {
  id              String                 @id @default(uuid()) @db.Uuid
  customerId      String                 @db.Uuid
  orderId         String?                @db.Uuid
  returnRequestId String?                @db.Uuid
  type            NotificationEventType
  communicationCategory CommunicationCategory @default(REQUIRED_TRANSACTIONAL)
  payload         Json?
  idempotencyKey  String?                @unique @db.VarChar(255)
  correlationId   String?                @db.VarChar(128)
  createdAt       DateTime               @default(now())
  deliveries      NotificationDelivery[]
  @@index([customerId, createdAt])
  @@index([orderId, createdAt])
  @@index([returnRequestId, createdAt])
  @@index([type, createdAt])
  @@index([idempotencyKey])
}

model NotificationDelivery {
  id                  String                    @id @default(uuid()) @db.Uuid
  notificationEventId String                    @db.Uuid
  customerId          String                    @db.Uuid
  channel             NotificationChannel
  templateKey         String                    @db.VarChar(120)
  templateVersion     Int                       @default(1)
  locale              String                    @default("en-IN") @db.VarChar(16)
  recipientAddress    String?                   @db.VarChar(320)
  status              NotificationDeliveryStatus @default(PENDING)
  attempts            Int                       @default(0)
  maxAttempts         Int                       @default(5)
  nextAttemptAt       DateTime?
  lastAttemptAt       DateTime?
  sentAt              DateTime?
  deliveredAt         DateTime?
  providerId          String?                   @db.VarChar(64)
  providerReference   String?                   @db.VarChar(255)
  failureCategory     NotificationFailureCategory?
  suppressionReason   CommunicationSuppressionReason?
  failureCode         String?                   @db.VarChar(120)
  correlationId       String?                   @db.VarChar(128)
  idempotencyKey      String                    @unique @db.VarChar(255)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  notificationEvent   NotificationEvent        @relation(fields: [notificationEventId], references: [id], onDelete: Cascade)
  customer            Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt, createdAt])
  @@index([customerId, createdAt])
  @@index([notificationEventId])
  @@index([providerId, providerReference])
  @@index([correlationId, createdAt])
}


enum AnalyticsConsentState {
  OPTED_OUT
  OPTED_IN
}

enum AnalyticsConsentSource {
  CUSTOMER_SETTINGS
  SYSTEM
}

enum AnalyticsEventSource {
  CLIENT
  SERVER
}

model CustomerAnalyticsConsent {
  id         String                @id @default(uuid()) @db.Uuid
  customerId String                @unique @db.Uuid
  state      AnalyticsConsentState @default(OPTED_OUT)
  source     AnalyticsConsentSource @default(SYSTEM)
  version    Int                   @default(1)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  customer   Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id            String              @id @default(uuid()) @db.Uuid
  eventId       String              @unique @db.VarChar(64)
  eventName     String              @db.VarChar(64)
  eventVersion  Int
  occurredAt    DateTime
  receivedAt    DateTime            @default(now())
  anonymousId   String?             @db.VarChar(64)
  sessionId     String?             @db.VarChar(64)
  customerId    String?             @db.Uuid
  locale        String?             @db.VarChar(16)
  context       Json?
  properties    Json
  source        AnalyticsEventSource
  expiresAt     DateTime
  customer      Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([expiresAt])
  @@index([customerId, occurredAt])
  @@index([eventName, occurredAt])
}

