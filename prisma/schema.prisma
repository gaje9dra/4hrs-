generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
enum ProductVariantStatus {
  ACTIVE
  INACTIVE
}
enum CategoryStatus {
  ACTIVE
  ARCHIVED
}
enum CollectionStatus {
  ACTIVE
  ARCHIVED
}
enum CustomerAccountStatus {
  ACTIVE
  DISABLED
  SUSPENDED
  PENDING_VERIFICATION
}

enum ProductMediaType {
  IMAGE
}
enum CatalogImportEntityType {
  PRODUCT
  VARIANT
}


model CatalogImportIdentity {
  id                String                  @id @default(uuid()) @db.Uuid
  entityType        CatalogImportEntityType
  namespace         String
  externalReference String
  canonicalId       String                  @db.Uuid
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  @@unique([entityType, namespace, externalReference])
  @@index([entityType, canonicalId])
  @@index([namespace, externalReference])
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  title            String
  slug             String        @unique
  description      String?
  shortDescription String?
  status           ProductStatus @default(DRAFT)
  price            Decimal       @db.Decimal(12, 2)
  compareAtPrice   Decimal?      @db.Decimal(12, 2)
  currency         String        @default("INR") @db.VarChar(3)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  variants         ProductVariant[]
  optionTypes      ProductOptionType[]
  images           ProductImage[]
  categories       ProductCategory[]
  collections      ProductCollection[]
  tags             ProductTag[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  @@index([status])
  @@index([createdAt])
  @@index([price])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([status, price])
  @@index([status, title])
}


enum CatalogAuditEntityType {
  PRODUCT
  VARIANT
  MEDIA
  CATEGORY
  COLLECTION
  TAG
  OPTION_TYPE
  OPTION_VALUE
  PRODUCT_CATEGORY
  PRODUCT_COLLECTION
  PRODUCT_TAG
}

enum CatalogAuditOperation {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  PUBLISH
  UNPUBLISH
  DELETE
  RELATIONSHIP_ADD
  RELATIONSHIP_REMOVE
  REORDER
  IMPORT
  BULK_UPDATE
}

enum CatalogAuditSource {
  MANUAL
  IMPORT
  BULK_OPERATION
  SYSTEM
  PROVIDER_SYNC
}

enum CatalogAuditActorType {
  USER
  PROCESS
  IMPORT
  PROVIDER
}

model CatalogAuditEvent {
  id             String                   @id @default(uuid()) @db.Uuid
  entityType     CatalogAuditEntityType
  entityId       String                   @db.Uuid
  operation      CatalogAuditOperation
  source         CatalogAuditSource
  actorType      CatalogAuditActorType?
  actorId        String?
  correlationId  String?
  changedFields  String[]
  beforeState    Json?
  afterState     Json?
  metadata       Json?
  createdAt      DateTime                 @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([source, operation, createdAt])
  @@index([actorId, createdAt])
  @@index([correlationId, createdAt])
}

enum InventoryAdjustmentReason {
  INITIAL_STOCK
  MANUAL_ADJUSTMENT
  STOCK_RECEIPT
  DAMAGED
  LOST
  RETURNED
  CORRECTION
}

model Inventory {
  id                  String      @id @default(uuid()) @db.Uuid
  variantId           String      @unique @db.Uuid
  trackingEnabled     Boolean     @default(true)
  onHand              Int         @default(0)
  reserved            Int         @default(0)
  lowStockThreshold   Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  variant             ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  transactions        InventoryTransaction[]
  @@index([trackingEnabled])
}

model InventoryTransaction {
  id                String                   @id @default(uuid()) @db.Uuid
  inventoryId       String                   @db.Uuid
  quantityDelta     Int
  previousOnHand    Int
  resultingOnHand   Int
  reason            InventoryAdjustmentReason
  actorId           String?
  source            String?
  note              String?
  reference         String?
  createdAt         DateTime                 @default(now())
  inventory         Inventory                @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  @@index([inventoryId, createdAt])
  @@index([reason, createdAt])
}

model VariantOptionType {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  normalizedName String     @unique
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  values      VariantOptionValue[]
  products    ProductOptionType[]
}

model VariantOptionValue {
  id             String             @id @default(uuid()) @db.Uuid
  optionTypeId   String             @db.Uuid
  displayName    String
  normalizedValue String
  sortOrder     Int                @default(0)
  hex            String?
  swatch         String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  optionType     VariantOptionType  @relation(fields: [optionTypeId], references: [id], onDelete: Restrict)
  variants       ProductVariantOptionValue[]
  @@unique([optionTypeId, normalizedValue])
  @@index([optionTypeId, sortOrder])
}

model ProductOptionType {
  productId    String            @db.Uuid
  optionTypeId String            @db.Uuid
  sortOrder    Int               @default(0)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionType  VariantOptionType @relation(fields: [optionTypeId], references: [id], onDelete: Restrict)
  @@id([productId, optionTypeId])
  @@index([productId, sortOrder])
}

model ProductVariantOptionValue {
  variantId     String             @db.Uuid
  optionValueId String             @db.Uuid
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   VariantOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)
  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

model ProductVariant {
  id             String               @id @default(uuid()) @db.Uuid
  productId      String               @db.Uuid
  displayName    String?
  size           String?
  color          String?
  sku            String               @unique
  price          Decimal?             @db.Decimal(12, 2)
  compareAtPrice Decimal?             @db.Decimal(12, 2)
  status         ProductVariantStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  images         ProductImage[]
  inventory      Inventory?
  optionValues   ProductVariantOptionValue[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  providerMappings FulfillmentProviderMapping[]
  @@index([productId])
  @@index([status])
  @@index([productId, size, color])
}

model ProductImage {
  id               String          @id @default(uuid()) @db.Uuid
  productId        String?         @db.Uuid
  variantId        String?         @db.Uuid
  url              String
  storageReference String?
  mediaType        ProductMediaType @default(IMAGE)
  altText          String?
  sortOrder        Int             @default(0)
  isPrimary        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  product   Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@index([productId])
  @@index([variantId])
  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  slug        String         @unique
  description String?
  seoTitle    String?
  seoDescription String?
  parentId    String?        @db.Uuid
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryHierarchy")
  products    ProductCategory[]
  @@index([parentId])
  @@index([status])
}

model Collection {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  description String?
  seoTitle    String?
  seoDescription String?
  status      CollectionStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  products    ProductCollection[]
  @@index([status])
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  ProductTag[]
}

model ProductCategory {
  productId  String @db.Uuid
  categoryId String @db.Uuid
  position   Int    @default(0)
  priority   Int    @default(0)
  isFeatured Boolean @default(false)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  @@id([productId, categoryId])
  @@index([categoryId, isFeatured, priority, position])
}

model ProductCollection {
  productId    String @db.Uuid
  collectionId String @db.Uuid
  position     Int     @default(0)
  priority     Int     @default(0)
  isFeatured   Boolean @default(false)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  @@id([productId, collectionId])
  @@index([collectionId, isFeatured, priority, position])
}

model ProductTag {
  productId String @db.Uuid
  tagId     String @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([productId, tagId])
  @@index([tagId])
}


model Customer {
  id              String               @id @default(uuid()) @db.Uuid
  email           String               @unique @db.VarChar(320)
  displayName     String?              @db.VarChar(120)
  status          CustomerAccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  credential      CustomerCredential?
  sessions        CustomerSession[]
  cart            Cart?
  addresses       CustomerAddress[]
  payments        Payment[]
  paymentIdempotencyRecords PaymentIdempotency[]
  orders          Order[]
  @@index([status])
}

model CustomerAddress {
  id               String   @id @default(uuid()) @db.Uuid
  customerId       String   @db.Uuid
  recipientName    String   @db.VarChar(120)
  phone            String?  @db.VarChar(32)
  addressLine1     String   @db.VarChar(200)
  addressLine2     String?  @db.VarChar(200)
  city             String   @db.VarChar(100)
  stateOrProvince  String   @db.VarChar(100)
  postalCode       String   @db.VarChar(32)
  countryCode      String   @db.Char(2)
  label            String   @db.VarChar(40)
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@index([customerId, createdAt])
  @@index([customerId, updatedAt])
}

model CustomerCredential {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @unique @db.Uuid
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerSession {
  id              String    @id @default(uuid()) @db.Uuid
  customerId      String    @db.Uuid
  sessionTokenHash String   @unique @db.VarChar(128)
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@index([customerId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String?    @unique @db.Uuid
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      CartItem[]
}

model CartItem {
  id          String          @id @default(uuid()) @db.Uuid
  cartId      String          @db.Uuid
  productId   String          @db.Uuid
  variantId   String?         @db.Uuid
  quantity    Int             @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  cart        Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@index([cartId, productId, variantId])
}


enum PaymentStatus {
  CREATED
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentEventProcessingStatus {
  RECEIVED
  PROCESSED
  FAILED
}


enum OrderStatus {
  PENDING
  CONFIRMED
}

model Order {
  id               String      @id @default(uuid()) @db.Uuid
  customerId       String      @db.Uuid
  checkoutReference String     @unique @db.VarChar(128)
  paymentId        String      @unique @db.Uuid
  orderNumber      String      @unique @db.VarChar(40)
  status           OrderStatus @default(PENDING)
  subtotal         Decimal     @db.Decimal(12, 2)
  total            Decimal     @db.Decimal(12, 2)
  currency         String      @db.VarChar(3)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  customer         Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payment          Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  shippingAddress  OrderAddressSnapshot?
  fulfillment      Fulfillment?

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id                    String          @id @default(uuid()) @db.Uuid
  orderId               String          @db.Uuid
  productId             String?         @db.Uuid
  variantId             String?         @db.Uuid
  productTitleSnapshot  String          @db.VarChar(255)
  variantTitleSnapshot  String?         @db.VarChar(255)
  skuSnapshot           String?         @db.VarChar(120)
  selectedOptionsSnapshot Json?
  quantity              Int
  unitPrice             Decimal         @db.Decimal(12, 2)
  lineTotal             Decimal         @db.Decimal(12, 2)
  currency              String          @db.VarChar(3)
  createdAt             DateTime        @default(now())
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant              ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  fulfillmentItems     FulfillmentItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderAddressSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @unique @db.Uuid
  recipientName    String   @db.VarChar(120)
  phone            String?  @db.VarChar(32)
  addressLine1     String   @db.VarChar(200)
  addressLine2     String?  @db.VarChar(200)
  city             String   @db.VarChar(100)
  stateOrProvince  String   @db.VarChar(100)
  postalCode       String   @db.VarChar(32)
  countryCode      String   @db.Char(2)
  label            String?  @db.VarChar(40)
  createdAt        DateTime @default(now())
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}



enum FulfillmentStatus {
  PENDING
  SUBMITTED
  FAILED
  COMPLETED
}

model FulfillmentProviderMapping {
  id                       String         @id @default(uuid()) @db.Uuid
  variantId                String         @db.Uuid
  providerId               String         @db.VarChar(64)
  providerSku              String         @db.VarChar(120)
  providerVariantReference String?        @db.VarChar(255)
  active                   Boolean        @default(true)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  variant                  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, providerId])
  @@unique([providerId, providerSku])
  @@index([providerId, active])
  @@index([variantId, active])
}

model Fulfillment {
  id                    String             @id @default(uuid()) @db.Uuid
  orderId               String             @unique @db.Uuid
  provider              String             @db.VarChar(64)
  providerFulfillmentReference String?      @unique @db.VarChar(255)
  status                FulfillmentStatus  @default(PENDING)
  idempotencyKey        String             @unique @db.VarChar(255)
  requestedAt           DateTime           @default(now())
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  submittedAt           DateTime?
  acceptedAt            DateTime?
  completedAt           DateTime?
  failedAt              DateTime?
  errorCode             String?            @db.VarChar(100)
  errorMessage          String?            @db.VarChar(500)
  reconciliationMetadata Json?
  order                 Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items                 FulfillmentItem[]

  @@index([provider, createdAt])
  @@index([provider, providerFulfillmentReference])
  @@index([status, createdAt])
  @@index([orderId, status])
}

model FulfillmentItem {
  id                        String       @id @default(uuid()) @db.Uuid
  fulfillmentId             String       @db.Uuid
  orderItemId               String       @unique @db.Uuid
  quantity                  Int
  providerItemReference     String?      @db.VarChar(255)
  providerSku               String?      @db.VarChar(120)
  providerVariantReference  String?      @db.VarChar(255)
  status                    String?      @db.VarChar(64)
  createdAt                 DateTime     @default(now())
  fulfillment               Fulfillment  @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItem                 OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([fulfillmentId])
  @@index([orderItemId])
  @@index([providerItemReference])
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  customerId         String        @db.Uuid
  checkoutReference  String        @db.VarChar(128)
  internalReference  String        @unique @db.VarChar(64)
  providerId         String?       @db.VarChar(64)
  providerReference  String?       @db.VarChar(255)
  status             PaymentStatus @default(CREATED)
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @db.VarChar(3)
  completedAt        DateTime?
  expiresAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  attempts           PaymentAttempt[]
  events             PaymentEvent[]
  idempotencyRecords PaymentIdempotency[]
  order            Order?

  @@unique([customerId, checkoutReference])
  @@index([customerId, createdAt])
  @@index([checkoutReference])
  @@index([providerId, providerReference])
  @@index([status, createdAt])
}

model PaymentAttempt {
  id                    String        @id @default(uuid()) @db.Uuid
  paymentId             String        @db.Uuid
  attemptNumber         Int
  providerId            String?       @db.VarChar(64)
  providerAttemptReference String?    @db.VarChar(255)
  status                PaymentStatus @default(CREATED)
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @db.VarChar(3)
  failureCode           String?       @db.VarChar(100)
  failureCategory       String?       @db.VarChar(100)
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  payment               Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, attemptNumber])
  @@index([paymentId, createdAt])
  @@index([providerId, providerAttemptReference])
  @@index([status, createdAt])
}

model PaymentEvent {
  id                    String                     @id @default(uuid()) @db.Uuid
  providerId            String                     @db.VarChar(64)
  providerEventId       String                     @db.VarChar(255)
  eventType             String                     @db.VarChar(120)
  normalizedEventType   String?                    @db.VarChar(120)
  paymentId             String?                    @db.Uuid
  receivedAt             DateTime                   @default(now())
  occurredAt            DateTime?
  processedAt           DateTime?
  processingStatus      PaymentEventProcessingStatus @default(RECEIVED)
  processingError       String?                    @db.VarChar(500)
  metadata              Json?
  payment               Payment?                   @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([providerId, providerEventId])
  @@index([paymentId, receivedAt])
  @@index([providerId, receivedAt])
  @@index([processingStatus, receivedAt])
}

model PaymentIdempotency {
  id                String   @id @default(uuid()) @db.Uuid
  customerId        String   @db.Uuid
  checkoutReference String   @db.VarChar(128)
  operation         String   @db.VarChar(64)
  key               String   @db.VarChar(255)
  requestFingerprint String  @db.VarChar(128)
  paymentId         String   @db.Uuid
  response           Json?
  createdAt         DateTime @default(now())
  expiresAt         DateTime?
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([customerId, operation, key])
  @@index([paymentId])
  @@index([customerId, checkoutReference])
  @@index([expiresAt])
}
