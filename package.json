{
  "name": "4hrs-fashion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "prisma migrate deploy && tsx --test --test-concurrency=1",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "lucide-react": "^0.468.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.1.14",
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.5",
    "prisma": "^6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.0"
  }
}
