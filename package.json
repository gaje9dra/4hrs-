{
  "name": "4hrs-fashion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "prisma migrate deploy && tsx --test --test-concurrency=1",
    "postinstall": "prisma generate",
    "admin:provision": "tsx scripts/provision-admin.ts",
    "recovery:validate": "tsx scripts/recovery-validate.ts",
    "recovery:drill": "tsx scripts/recovery-drill.ts",
    "release:validate": "tsx scripts/validate-environment.ts",
    "release:check": "npm run lint && npm run typecheck && npm test && npm run build",
    "release:verify": "tsx scripts/release-verify.ts",
    "db:audit-migrations": "tsx scripts/audit-migrations.ts",
    "reliability:validate": "tsx -e \"import { SLO_CANDIDATES, DEPENDENCY_POLICIES } from './lib/reliability/model.ts'; if (!SLO_CANDIDATES.every((x) => x.provisional)) process.exit(1); console.log(JSON.stringify({sloCandidates:SLO_CANDIDATES.length, dependencies:Object.keys(DEPENDENCY_POLICIES).length}));\"",
    "architecture:audit": "tsx scripts/platform-maturity-audit.ts",
    "reconciliation:audit": "tsx scripts/reconciliation-audit.ts",
    "synthetic:validate": "tsx scripts/synthetic-audit.ts",
    "synthetic:ci": "tsx scripts/synthetic-ci.ts",
    "synthetic:monitor": "tsx scripts/synthetic-monitor.ts",
    "platform:certify": "tsx scripts/platform-certification.ts",
    "operations:validate": "tsx scripts/operations-validate.ts",
    "operations:verify-deployment": "tsx scripts/operations-verify-deployment.ts",
    "automation:validate": "tsx scripts/automation-validate.ts",
    "reliability:autonomous:validate": "tsx scripts/reliability-autonomous-validate.ts",
    "resilience:validate": "tsx scripts/resilience-validate.ts",
    "resilience:catalog:seed": "tsx scripts/resilience-catalog-seed.ts",
    "rehearsal:validate": "tsx scripts/rehearsal-validate.ts",
    "rehearsal:test": "tsx --test tests/phase-15-29-rehearsal.test.ts",
    "improvement:validate": "tsx scripts/improvement-validate.ts",
    "architecture:validate": "tsx scripts/architecture-validate.ts",
    "platform-graph:validate": "tsx scripts/platform-graph-validate.ts",
    "simulation:validate": "tsx scripts/simulation-validate.ts",
    "change-governance:validate": "tsx scripts/change-governance-validate.ts",
    "release-governance:validate": "tsx scripts/release-governance-validate.ts",
    "deployment-control:validate": "tsx scripts/deployment-control-validate.ts",
    "delivery-orchestration:validate": "tsx scripts/delivery-orchestration-validate.ts",
    "delivery-intelligence:validate": "tsx scripts/delivery-intelligence-validate.ts",
    "delivery-intelligence:completion:validate": "tsx scripts/delivery-intelligence-completion-validate.ts",
    "delivery-intelligence:maintenance": "tsx scripts/delivery-intelligence-maintenance.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.1.14",
    "@prisma/client": "^6.19.0",
    "@netlify/functions": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prisma": "^6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "packageManager": "npm@11.6.0"
}
