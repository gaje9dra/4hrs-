# Fulfillment provider selection (server-only)
FULFILLMENT_PROVIDER_ID=qikink
FULFILLMENT_PROVIDER_ENABLED=false
FULFILLMENT_PROVIDER_MODE=live
FULFILLMENT_PROVIDER_SECRET_REFERENCE=QIKINK_AUTH_TOKEN
FULFILLMENT_PROVIDER_TIMEOUT_MS=10000

# Qikink server-only credential. Set this in local/Netlify environment variables.
# Never commit the real token.
QIKINK_AUTH_TOKEN=
