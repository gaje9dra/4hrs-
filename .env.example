# Public canonical origin for SEO metadata, robots, sitemap, and production configuration validation.
# Production must use HTTPS.
NEXT_PUBLIC_SITE_URL=https://example.com

# Database (server-only; never expose through NEXT_PUBLIC_ variables)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fourhrs
DIRECT_URL=

# Release identity (server-only)
APP_VERSION=0.1.0
COMMIT_SHA=
DEPLOY_ID=
CONTEXT=


# Payment provider configuration (server-only)
# Production must use a verified live provider adapter; controlled-sandbox is test-only.
PAYMENT_PROVIDER_ID=controlled-sandbox
PAYMENT_PROVIDER_ENABLED=false
PAYMENT_PROVIDER_MODE=test
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_REFERENCE=
PAYMENT_PROVIDER_WEBHOOK_SECRET_REFERENCE=
PAYMENT_PROVIDER_TIMEOUT_MS=10000
PAYMENT_SANDBOX_WEBHOOK_SECRET=
PAYMENT_SANDBOX_SCENARIO=

# Fulfillment provider selection (server-only)
FULFILLMENT_PROVIDER_ID=qikink
FULFILLMENT_PROVIDER_ENABLED=false
FULFILLMENT_PROVIDER_MODE=test
FULFILLMENT_PROVIDER_SECRET_REFERENCE=QIKINK_CLIENT_SECRET
FULFILLMENT_PROVIDER_TIMEOUT_MS=10000
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
QIKINK_SANDBOX_SECRET=
QIKINK_AUTH_TOKEN=

# Administrative provisioning (server-only; provisioning is an explicit operational command)
ADMIN_EMAILS=
ADMIN_PROVISION_EMAIL=
ADMIN_PROVISION_PASSWORD=
ADMIN_PROVISION_ROLE=VIEWER
RETURN_WINDOW_DAYS=7

# Transactional notifications (server-only; no production provider is implemented in Phase 15.7)
NOTIFICATION_PROVIDER_ENABLED=false
NOTIFICATION_PROVIDER_ID=none
NOTIFICATION_PROVIDER_MODE=test
NOTIFICATION_PROVIDER_TIMEOUT_MS=10000

# Communication unsubscribe tokens (server-only; required before issuing production unsubscribe links)
NOTIFICATION_UNSUBSCRIBE_SECRET=
