# Fulfillment provider selection (server-only)
FULFILLMENT_PROVIDER_ID=qikink
FULFILLMENT_PROVIDER_ENABLED=false
# Use "test" with Qikink Sandbox credentials. Use "live" only with Live API credentials.
FULFILLMENT_PROVIDER_MODE=test
FULFILLMENT_PROVIDER_SECRET_REFERENCE=QIKINK_CLIENT_SECRET
FULFILLMENT_PROVIDER_TIMEOUT_MS=10000

# Qikink Open API credentials (server-only).
# Sandbox: use the Sandbox Client ID + Sandbox Client Secret from Qikink.
# Live: use the Live Client ID + Live Client Secret.
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
# Optional alias for the Sandbox secret. If present, it is preferred in test mode.
QIKINK_SANDBOX_SECRET=

# Optional legacy Qikink auth token. Used only when Client ID/Secret are not configured.
QIKINK_AUTH_TOKEN=

# Legacy administrator allowlist. Deprecated: provision AdminUser + roles instead.
ADMIN_EMAILS=

# Secure one-time administrator provisioning inputs. Never commit real values.
ADMIN_PROVISION_EMAIL=
ADMIN_PROVISION_PASSWORD=
ADMIN_PROVISION_ROLE=VIEWER

# Customer return policy baseline (days after confirmed delivery)
RETURN_WINDOW_DAYS=7
